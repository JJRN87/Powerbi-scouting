// Crear consulta en blanco llamada Fuente y pegar en Editor avanzado.
let
    Carpeta = "E:/Proyecto_Futbol/data/processed",
    Leer = (nombre as text, tipos as list) as table =>
        let
            Csv = Csv.Document(File.Contents(Carpeta & "/" & nombre & ".csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
            Cabecera = Table.PromoteHeaders(Csv, [PromoteAllScalars=true]),
            Nulos = Table.ReplaceValue(Cabecera, "", null, Replacer.ReplaceValue, Table.ColumnNames(Cabecera)),
            Tipos = Table.TransformColumnTypes(Nulos, tipos, "en-US")
        in Tipos,
    Tablas = [
        players_season = Leer("players_season", {{"player_id", Int64.Type}, {"player", type text}, {"full_name", type text}, {"country", type text}, {"teams", type text}, {"matches", Int64.Type}, {"starts", Int64.Type}, {"minutes", type number}, {"primary_role", type text}, {"primary_role_share", type number}, {"minutes_AM", type number}, {"minutes_CB", type number}, {"minutes_CM", type number}, {"minutes_DM", type number}, {"minutes_FB", type number}, {"minutes_GK", type number}, {"minutes_ST", type number}, {"minutes_W", type number}, {"passes_attempted", Int64.Type}, {"passes_completed", Int64.Type}, {"passes_excluded", Int64.Type}, {"progressive_passes", Int64.Type}, {"final_third_passes", Int64.Type}, {"key_passes", Int64.Type}, {"assists", Int64.Type}, {"xg_assisted", type number}, {"shots", Int64.Type}, {"shots_on_target", Int64.Type}, {"goals", Int64.Type}, {"non_penalty_goals", Int64.Type}, {"xg", type number}, {"npxg", type number}, {"dribbles_attempted", Int64.Type}, {"dribbles_completed", Int64.Type}, {"progressive_carries", Int64.Type}, {"tackles_attempted", Int64.Type}, {"tackles_won", Int64.Type}, {"interceptions", Int64.Type}, {"recoveries", Int64.Type}, {"pressures", Int64.Type}, {"aerial_wins", Int64.Type}, {"clearances", Int64.Type}, {"blocks", Int64.Type}, {"dribbled_past", Int64.Type}, {"dispossessed", Int64.Type}, {"miscontrols", Int64.Type}, {"box_touches", Int64.Type}, {"fouls_committed", Int64.Type}, {"key_passes_open_play", Int64.Type}, {"key_passes_set_piece", Int64.Type}, {"xg_assisted_open_play", type number}, {"xg_assisted_set_piece", type number}, {"passes_attempted_p90", type number}, {"passes_completed_p90", type number}, {"progressive_passes_p90", type number}, {"final_third_passes_p90", type number}, {"key_passes_p90", type number}, {"assists_p90", type number}, {"xg_assisted_p90", type number}, {"shots_p90", type number}, {"shots_on_target_p90", type number}, {"goals_p90", type number}, {"non_penalty_goals_p90", type number}, {"xg_p90", type number}, {"npxg_p90", type number}, {"dribbles_attempted_p90", type number}, {"dribbles_completed_p90", type number}, {"progressive_carries_p90", type number}, {"tackles_attempted_p90", type number}, {"tackles_won_p90", type number}, {"interceptions_p90", type number}, {"recoveries_p90", type number}, {"pressures_p90", type number}, {"aerial_wins_p90", type number}, {"clearances_p90", type number}, {"blocks_p90", type number}, {"dribbled_past_p90", type number}, {"dispossessed_p90", type number}, {"miscontrols_p90", type number}, {"box_touches_p90", type number}, {"fouls_committed_p90", type number}, {"key_passes_open_play_p90", type number}, {"key_passes_set_piece_p90", type number}, {"xg_assisted_open_play_p90", type number}, {"xg_assisted_set_piece_p90", type number}, {"pass_completion_pct", type number}, {"dribble_success_pct", type number}, {"tackle_success_pct", type number}}),
        player_match = Leer("player_match", {{"match_id", Int64.Type}, {"match_date", type text}, {"match_week", Int64.Type}, {"player_id", Int64.Type}, {"player", type text}, {"full_name", type text}, {"team_id", Int64.Type}, {"team", type text}, {"country", type text}, {"minutes", type number}, {"started", Int64.Type}, {"minutes_AM", type number}, {"minutes_CB", type number}, {"minutes_CM", type number}, {"minutes_DM", type number}, {"minutes_FB", type number}, {"minutes_GK", type number}, {"minutes_ST", type number}, {"minutes_W", type number}, {"passes_attempted", Int64.Type}, {"passes_completed", Int64.Type}, {"passes_excluded", Int64.Type}, {"progressive_passes", Int64.Type}, {"final_third_passes", Int64.Type}, {"key_passes", Int64.Type}, {"assists", Int64.Type}, {"xg_assisted", type number}, {"shots", Int64.Type}, {"shots_on_target", Int64.Type}, {"goals", Int64.Type}, {"non_penalty_goals", Int64.Type}, {"xg", type number}, {"npxg", type number}, {"dribbles_attempted", Int64.Type}, {"dribbles_completed", Int64.Type}, {"progressive_carries", Int64.Type}, {"tackles_attempted", Int64.Type}, {"tackles_won", Int64.Type}, {"interceptions", Int64.Type}, {"recoveries", Int64.Type}, {"pressures", Int64.Type}, {"aerial_wins", Int64.Type}, {"clearances", Int64.Type}, {"blocks", Int64.Type}, {"dribbled_past", Int64.Type}, {"dispossessed", Int64.Type}, {"miscontrols", Int64.Type}, {"box_touches", Int64.Type}, {"fouls_committed", Int64.Type}, {"key_passes_open_play", Int64.Type}, {"key_passes_set_piece", Int64.Type}, {"xg_assisted_open_play", type number}, {"xg_assisted_set_piece", type number}, {"passes_attempted_p90", type number}, {"passes_completed_p90", type number}, {"progressive_passes_p90", type number}, {"final_third_passes_p90", type number}, {"key_passes_p90", type number}, {"assists_p90", type number}, {"xg_assisted_p90", type number}, {"shots_p90", type number}, {"shots_on_target_p90", type number}, {"goals_p90", type number}, {"non_penalty_goals_p90", type number}, {"xg_p90", type number}, {"npxg_p90", type number}, {"dribbles_attempted_p90", type number}, {"dribbles_completed_p90", type number}, {"progressive_carries_p90", type number}, {"tackles_attempted_p90", type number}, {"tackles_won_p90", type number}, {"interceptions_p90", type number}, {"recoveries_p90", type number}, {"pressures_p90", type number}, {"aerial_wins_p90", type number}, {"clearances_p90", type number}, {"blocks_p90", type number}, {"dribbled_past_p90", type number}, {"dispossessed_p90", type number}, {"miscontrols_p90", type number}, {"box_touches_p90", type number}, {"fouls_committed_p90", type number}, {"key_passes_open_play_p90", type number}, {"key_passes_set_piece_p90", type number}, {"xg_assisted_open_play_p90", type number}, {"xg_assisted_set_piece_p90", type number}, {"pass_completion_pct", type number}, {"dribble_success_pct", type number}, {"tackle_success_pct", type number}}),
        matches = Leer("matches", {{"match_id", Int64.Type}, {"match_date", type text}, {"match_week", Int64.Type}, {"home_team_id", Int64.Type}, {"home_team", type text}, {"away_team_id", Int64.Type}, {"away_team", type text}, {"home_goals", Int64.Type}, {"away_goals", Int64.Type}, {"events", Int64.Type}, {"goals_reconciled", Int64.Type}}),
        position_stints = Leer("position_stints", {{"match_id", Int64.Type}, {"player_id", Int64.Type}, {"team_id", Int64.Type}, {"stint", Int64.Type}, {"position_id", Int64.Type}, {"role", type text}, {"from_clock", type text}, {"to_clock", type text}, {"from_period", Int64.Type}, {"to_period", Int64.Type}, {"minutes", type number}, {"end_reason", type text}}),
        rankings = Leer("rankings", {{"candidate_id", type text}, {"profile_id", type text}, {"profile", type text}, {"player_id", Int64.Type}, {"player", type text}, {"teams", type text}, {"primary_role", type text}, {"minutes", type number}, {"role_share", type number}, {"matches", Int64.Type}, {"score_base", type number}, {"rank_base", Int64.Type}, {"cohort_size", Int64.Type}, {"metric_1", type text}, {"percentile_1", type number}, {"weight_1", Int64.Type}, {"metric_2", type text}, {"percentile_2", type number}, {"weight_2", Int64.Type}, {"metric_3", type text}, {"percentile_3", type number}, {"weight_3", Int64.Type}, {"metric_4", type text}, {"percentile_4", type number}, {"weight_4", Int64.Type}, {"metric_5", type text}, {"percentile_5", type number}, {"weight_5", Int64.Type}, {"metric_6", type text}, {"percentile_6", type number}, {"weight_6", Int64.Type}, {"metric_7", type text}, {"percentile_7", type number}, {"weight_7", Int64.Type}, {"metric_8", type text}, {"percentile_8", type number}, {"weight_8", Int64.Type}}),
        ranking_detail = Leer("ranking_detail", {{"candidate_id", type text}, {"profile_id", type text}, {"player_id", Int64.Type}, {"slot", Int64.Type}, {"metric_id", type text}, {"value", type number}, {"percentile", type number}, {"weight_base", Int64.Type}, {"contribution_base", type number}}),
        profiles = Leer("profiles", {{"profile_id", type text}, {"profile", type text}, {"roles", type text}, {"minimum_minutes", Int64.Type}, {"minimum_role_share", type number}, {"cohort_size", Int64.Type}}),
        weights = Leer("weights", {{"profile_id", type text}, {"slot", Int64.Type}, {"metric_id", type text}, {"weight", Int64.Type}}),
        metrics = Leer("metrics", {{"metric_id", type text}, {"label", type text}, {"unit", type text}, {"direction", type text}, {"definition", type text}}),
        sensitivity = Leer("sensitivity", {{"profile_id", type text}, {"player_id", Int64.Type}, {"player", type text}, {"rank_base", Int64.Type}, {"best_rank", Int64.Type}, {"worst_rank", Int64.Type}, {"scenarios", Int64.Type}, {"top10_fraction", type number}}),
        event_exclusions = Leer("event_exclusions", {{"match_id", Int64.Type}, {"event_id", type text}, {"player_id", Int64.Type}, {"reason", type text}}),
        organizer_comparison = Leer("organizer_comparison", {{"candidate_id", type text}, {"player_id", Int64.Type}, {"player", type text}, {"rank_v1", Int64.Type}, {"score_v1", type number}, {"rank_creation_40", Int64.Type}, {"score_creation_40", type number}, {"rank_v2", Int64.Type}, {"score_v2", type number}, {"key_passes_open_play_p90", type number}, {"key_passes_set_piece_p90", type number}, {"xg_assisted_open_play_p90", type number}, {"xg_assisted_set_piece_p90", type number}})
    ]
in
    Tablas
