      {
        "name": "QA_resultados",
        "columns": [
          {
            "name": "Escenario",
            "dataType": "string",
            "isNameInferred": false,
            "lineageTag": "ced9014a-7967-4b21-8bcc-b14c9750fa8f",
            "sourceColumn": "[Escenario]",
            "summarizeBy": "none",
            "type": "calculatedTableColumn"
          },
          {
            "name": "Candidatos",
            "dataType": "int64",
            "isNameInferred": false,
            "lineageTag": "f00b6f77-096a-438e-95ff-d2e5f88941f0",
            "sourceColumn": "[Candidatos]",
            "summarizeBy": "none",
