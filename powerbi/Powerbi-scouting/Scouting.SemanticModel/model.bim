                " H=Table.PromoteHeaders(S,[PromoteAllScalars=true]),",
                " N=Table.ReplaceValue(H,\"\",null,Replacer.ReplaceValue,Table.ColumnNames(H)),",
                " T=Table.TransformColumnTypes(N,{{\"scenario\",type text},{\"candidate_id\",type text},{\"score\",type number},{\"rank\",Int64.Type}},\"en-US\")",
