          },
          {
            "name": "Errores score",
            "dataType": "int64",
            "isNameInferred": false,
            "lineageTag": "8a09da19-3d61-4b14-a658-a5bd5d721132",
            "sourceColumn": "[Errores score]",
            "summarizeBy": "none",
            "type": "calculatedTableColumn"
          },
          {
            "name": "Errores ranking",
            "dataType": "int64",
            "isNameInferred": false,
            "lineageTag": "60f93127-a8cf-41b5-ac6d-0cce496881d7",
            "sourceColumn": "[Errores ranking]",
            "summarizeBy": "none",
            "type": "calculatedTableColumn"
          }
        ],
        "lineageTag": "44068ab7-cdbc-4d65-86f7-621eb720316b",
        "partitions": [
          {
            "name": "QA_resultados",
            "mode": "import",
            "source": {
              "expression": [
                "VAR S0 = SUMMARIZECOLUMNS(rankings[profile_id], rankings[candidate_id], \"ActualScore\", [Puntuacion interactiva], \"ActualRank\", [Ranking interactivo], \"Keep\", COUNTROWS(rankings))",
                "VAR C0 = ADDCOLUMNS(S0, \"ExpectedScore\", LOOKUPVALUE(qa_expected[score], qa_expected[scenario], \"Base\", qa_expected[candidate_id], rankings[candidate_id]), \"ExpectedRank\", LOOKUPVALUE(qa_expected[rank], qa_expected[scenario], \"Base\", qa_expected[candidate_id], rankings[candidate_id]))",
                "VAR S1 = SUMMARIZECOLUMNS(rankings[profile_id], rankings[candidate_id], TREATAS({0}, Peso1[Value]), TREATAS({0}, Peso2[Value]), TREATAS({0}, Peso3[Value]), TREATAS({0}, Peso4[Value]), TREATAS({0}, Peso5[Value]), TREATAS({0}, Peso6[Value]), TREATAS({0}, Peso7[Value]), TREATAS({0}, Peso8[Value]), \"ActualScore\", [Puntuacion interactiva], \"ActualRank\", [Ranking interactivo], \"Keep\", COUNTROWS(rankings))",
                "VAR C1 = ADDCOLUMNS(S1, \"ExpectedScore\", LOOKUPVALUE(qa_expected[score], qa_expected[scenario], \"Ceros\", qa_expected[candidate_id], rankings[candidate_id]), \"ExpectedRank\", LOOKUPVALUE(qa_expected[rank], qa_expected[scenario], \"Ceros\", qa_expected[candidate_id], rankings[candidate_id]))",
                "VAR S2 = SUMMARIZECOLUMNS(rankings[profile_id], rankings[candidate_id], TREATAS({100}, Peso1[Value]), TREATAS({0}, Peso2[Value]), TREATAS({0}, Peso3[Value]), TREATAS({0}, Peso4[Value]), TREATAS({0}, Peso5[Value]), TREATAS({0}, Peso6[Value]), TREATAS({0}, Peso7[Value]), TREATAS({0}, Peso8[Value]), \"ActualScore\", [Puntuacion interactiva], \"ActualRank\", [Ranking interactivo], \"Keep\", COUNTROWS(rankings))",
                "VAR C2 = ADDCOLUMNS(S2, \"ExpectedScore\", LOOKUPVALUE(qa_expected[score], qa_expected[scenario], \"Solo progresion\", qa_expected[candidate_id], rankings[candidate_id]), \"ExpectedRank\", LOOKUPVALUE(qa_expected[rank], qa_expected[scenario], \"Solo progresion\", qa_expected[candidate_id], rankings[candidate_id]))",
                "VAR S3 = SUMMARIZECOLUMNS(rankings[profile_id], rankings[candidate_id], TREATAS({\"organizador\"}, profiles[profile_id]), TREATAS({32}, Peso1[Value]), TREATAS({15}, Peso2[Value]), TREATAS({20}, Peso3[Value]), TREATAS({2}, Peso4[Value]), TREATAS({3}, Peso5[Value]), TREATAS({5}, Peso6[Value]), TREATAS({15}, Peso7[Value]), TREATAS({8}, Peso8[Value]), \"ActualScore\", [Puntuacion interactiva], \"ActualRank\", [Ranking interactivo], \"Keep\", COUNTROWS(rankings))",
                "VAR C3 = ADDCOLUMNS(S3, \"ExpectedScore\", LOOKUPVALUE(qa_expected[score], qa_expected[scenario], \"Organizador 32 y 8\", qa_expected[candidate_id], rankings[candidate_id]), \"ExpectedRank\", LOOKUPVALUE(qa_expected[rank], qa_expected[scenario], \"Organizador 32 y 8\", qa_expected[candidate_id], rankings[candidate_id]))",
                "VAR S4 = SUMMARIZECOLUMNS(rankings[profile_id], rankings[candidate_id], TREATAS({\"organizador\"}, profiles[profile_id]), TREATAS({35}, Peso1[Value]), TREATAS({15}, Peso2[Value]), TREATAS({20}, Peso3[Value]), TREATAS({2}, Peso4[Value]), TREATAS({3}, Peso5[Value]), TREATAS({5}, Peso6[Value]), TREATAS({15}, Peso7[Value]), TREATAS({5}, Peso8[Value]), \"ActualScore\", [Puntuacion interactiva], \"ActualRank\", [Ranking interactivo], \"Keep\", COUNTROWS(rankings))",
                "VAR C4 = ADDCOLUMNS(S4, \"ExpectedScore\", LOOKUPVALUE(qa_expected[score], qa_expected[scenario], \"Organizador 35 y 5\", qa_expected[candidate_id], rankings[candidate_id]), \"ExpectedRank\", LOOKUPVALUE(qa_expected[rank], qa_expected[scenario], \"Organizador 35 y 5\", qa_expected[candidate_id], rankings[candidate_id]))",
                "VAR S5 = SUMMARIZECOLUMNS(rankings[profile_id], rankings[candidate_id], TREATAS({\"organizador\"}, profiles[profile_id]), TREATAS({25}, Peso1[Value]), TREATAS({15}, Peso2[Value]), TREATAS({25}, Peso3[Value]), TREATAS({2}, Peso4[Value]), TREATAS({3}, Peso5[Value]), TREATAS({5}, Peso6[Value]), TREATAS({15}, Peso7[Value]), TREATAS({10}, Peso8[Value]), \"ActualScore\", [Puntuacion interactiva], \"ActualRank\", [Ranking interactivo], \"Keep\", COUNTROWS(rankings))",
                "VAR C5 = ADDCOLUMNS(S5, \"ExpectedScore\", LOOKUPVALUE(qa_expected[score], qa_expected[scenario], \"Organizador xG 25\", qa_expected[candidate_id], rankings[candidate_id]), \"ExpectedRank\", LOOKUPVALUE(qa_expected[rank], qa_expected[scenario], \"Organizador xG 25\", qa_expected[candidate_id], rankings[candidate_id]))",
                "RETURN UNION(",
                "ROW(\"Escenario\", \"Base\", \"Candidatos\", COUNTROWS(C0), \"Esperados\", 387, \"Errores cohorte\", ABS(COUNTROWS(C0)-387), \"Errores score\", SUMX(C0, IF(ISBLANK([ActualScore]) <> ISBLANK([ExpectedScore]) || ABS([ActualScore]-[ExpectedScore]) > 0.0000001, 1, 0)), \"Errores ranking\", SUMX(C0, IF(ISBLANK([ActualRank]) <> ISBLANK([ExpectedRank]) || [ActualRank] <> [ExpectedRank], 1, 0))),",
                "ROW(\"Escenario\", \"Ceros\", \"Candidatos\", COUNTROWS(C1), \"Esperados\", 387, \"Errores cohorte\", ABS(COUNTROWS(C1)-387), \"Errores score\", SUMX(C1, IF(ISBLANK([ActualScore]) <> ISBLANK([ExpectedScore]) || ABS([ActualScore]-[ExpectedScore]) > 0.0000001, 1, 0)), \"Errores ranking\", SUMX(C1, IF(ISBLANK([ActualRank]) <> ISBLANK([ExpectedRank]) || [ActualRank] <> [ExpectedRank], 1, 0))),",
                "ROW(\"Escenario\", \"Solo progresion\", \"Candidatos\", COUNTROWS(C2), \"Esperados\", 387, \"Errores cohorte\", ABS(COUNTROWS(C2)-387), \"Errores score\", SUMX(C2, IF(ISBLANK([ActualScore]) <> ISBLANK([ExpectedScore]) || ABS([ActualScore]-[ExpectedScore]) > 0.0000001, 1, 0)), \"Errores ranking\", SUMX(C2, IF(ISBLANK([ActualRank]) <> ISBLANK([ExpectedRank]) || [ActualRank] <> [ExpectedRank], 1, 0))),",
                "ROW(\"Escenario\", \"Organizador 32 y 8\", \"Candidatos\", COUNTROWS(C3), \"Esperados\", 66, \"Errores cohorte\", ABS(COUNTROWS(C3)-66), \"Errores score\", SUMX(C3, IF(ISBLANK([ActualScore]) <> ISBLANK([ExpectedScore]) || ABS([ActualScore]-[ExpectedScore]) > 0.0000001, 1, 0)), \"Errores ranking\", SUMX(C3, IF(ISBLANK([ActualRank]) <> ISBLANK([ExpectedRank]) || [ActualRank] <> [ExpectedRank], 1, 0))),",
                "ROW(\"Escenario\", \"Organizador 35 y 5\", \"Candidatos\", COUNTROWS(C4), \"Esperados\", 66, \"Errores cohorte\", ABS(COUNTROWS(C4)-66), \"Errores score\", SUMX(C4, IF(ISBLANK([ActualScore]) <> ISBLANK([ExpectedScore]) || ABS([ActualScore]-[ExpectedScore]) > 0.0000001, 1, 0)), \"Errores ranking\", SUMX(C4, IF(ISBLANK([ActualRank]) <> ISBLANK([ExpectedRank]) || [ActualRank] <> [ExpectedRank], 1, 0))),",
                "ROW(\"Escenario\", \"Organizador xG 25\", \"Candidatos\", COUNTROWS(C5), \"Esperados\", 66, \"Errores cohorte\", ABS(COUNTROWS(C5)-66), \"Errores score\", SUMX(C5, IF(ISBLANK([ActualScore]) <> ISBLANK([ExpectedScore]) || ABS([ActualScore]-[ExpectedScore]) > 0.0000001, 1, 0)), \"Errores ranking\", SUMX(C5, IF(ISBLANK([ActualRank]) <> ISBLANK([ExpectedRank]) || [ActualRank] <> [ExpectedRank], 1, 0)))",
                ")"
              ],
              "type": "calculated"
            }
          }
        ]
      }
    ]
  }
}